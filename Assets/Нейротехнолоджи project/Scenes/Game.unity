  m_Name: 
  m_EditorClassIdentifier: 
  m_activationScenarioMode: 0
  m_alwaysActivate: 0
  m_componentName: 
  OnSetupEvent:
    m_PersistentCalls:
      m_Calls: []
  OnCompleteEvent:
    m_PersistentCalls:
      m_Calls: []
  m_trainText: "\u041F\u0440\u0438 \u0431\u0440\u043E\u0441\u043A\u0435 \u043C\u044F\u0447\u0430
    \u0432 \u043A\u043E\u043B\u044C\u0446\u043E \u0441\u043F\u043E\u0440\u0442\u0441\u043C\u0435\u043D
    \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
    \u0442\u0440\u0430\u0432\u043C\u044B \u043A\u043E\u043B\u0435\u043D\u0435\u0439
    \u0438 \u043A\u0438\u0441\u0442\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0441\u043C\u043E\u0436\u0435\u0442 \u0432\u044B\u043B\u0435\u0447\u0438\u0442\u044C
    \u0442\u0440\u0435\u043D\u0430\u0436\u0451\u0440 Sacrsus Physio \u0434\u043B\u044F
    \u043A\u043E\u043B\u0435\u043D\u043D\u043E\u0433\u043E \u0441\u0443\u0441\u0442\u0430\u0432\u0430
    \u0438 Cordus pro \u0434\u043B\u044F \u043A\u0438\u0441\u0442\u0435\u0439"
