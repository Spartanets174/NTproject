  OnCompleteEvent:
    m_PersistentCalls:
      m_Calls: []
  m_trainText: "\u0414\u043B\u044F \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B
    \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u0441\u0442\u0438 \u043B\u0435\u0447\u0435\u043D\u0438\u0435
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0430 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0432\u044B\u0431\u0440\u0430\u0442\u044C
    \u043D\u0443\u0436\u043D\u044B\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
    (Sacrus Physio \u0438\u043B\u0438 Cordus Pro) \u0437\u0430\u0442\u0435\u043C
    \u0443\u0441\u0442\u0440\u0430\u043D\u0438\u0442\u044C \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0443\u044E
    \u0442\u043E\u0447\u043A\u0443 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F
    \u0441 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u043C
    \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0443 \u0446\u0432\u0435\u0442\u043E\u043C  "
